{
  "name": "payload-dynamic",
  "version": "0.1.1",
  "description": "Native runtime-defined collections for Payload CMS (SQLite and PostgreSQL)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webcredo/payload-dynamic.git"
  },
  "homepage": "https://github.com/webcredo/payload-dynamic",
  "bugs": {
    "url": "https://github.com/webcredo/payload-dynamic/issues"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/CollectionsNavigation": {
      "types": "./dist/CollectionsNavigation.d.ts",
      "import": "./dist/CollectionsNavigation.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/fix-esm.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check --error-on-warnings && npm run typecheck && npm run knip",
    "lint": "biome lint --error-on-warnings",
    "format": "biome format",
    "format:write": "biome format --write",
    "knip": "knip",
    "knip:prune": "knip --fix --fix-type files --allow-remove-files",
    "prepack": "npm run build",
    "predev": "npm run build",
    "dev": "next dev --hostname 127.0.0.1",
    "predev:build": "npm run build",
    "dev:build": "payload build",
    "start": "next start --hostname 127.0.0.1",
    "preimportmap": "npm run build",
    "importmap": "payload generate:importmap",
    "types": "payload generate:types",
    "test:collections": "node --import tsx --test tests/payload-dynamic.test.mjs",
    "test:package": "node --test tests/package.test.mjs"
  },
  "peerDependencies": {
    "payload": "4.0.0-beta.9",
    "@payloadcms/ui": "4.0.0-beta.9",
    "@payloadcms/richtext-lexical": "4.0.0-beta.9",
    "@payloadcms/drizzle": "4.0.0-beta.9",
    "@payloadcms/db-postgres": "4.0.0-beta.9",
    "@payloadcms/db-sqlite": "4.0.0-beta.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependenciesMeta": {
    "@payloadcms/db-postgres": {
      "optional": true
    },
    "@payloadcms/db-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.9",
    "@payloadcms/db-sqlite": "4.0.0-beta.9",
    "@payloadcms/drizzle": "4.0.0-beta.9",
    "@payloadcms/next": "4.0.0-beta.9",
    "@payloadcms/richtext-lexical": "4.0.0-beta.9",
    "@payloadcms/ui": "4.0.0-beta.9",
    "graphql": "16.13.2",
    "next": "16.4.6",
    "payload": "4.0.0-beta.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.45.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "monaco-editor@0.57.0": {
      "dompurify": "3.4.18"
    }
  }
}
